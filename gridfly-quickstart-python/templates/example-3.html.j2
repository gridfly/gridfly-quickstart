{% macro render_example_3_subtotals_row(region, territory, area, store, level, report) -%}
    <tr class="level{{ level }}Subtotal">
        <td>{{ region.name if region else "" }}</td>
        <td>{{ territory.name if territory else "" }}</td>
        <td>{{ area.name if area else "" }}</td>
        <td>{{ store.name if store else "" }}</td>
        <td></td>
        {% for category, items in report.get_categories().items() %}
            {% for item in items %}
                <td gf-subtotal="{}">0</td>
            {% endfor %}
            <td gf-subtotal="{}">0</td>
        {% endfor %}
        <td gf-subtotal="{}">0</td>
    </tr>
{%- endmacro %}

<html>
    <head>
        <title>Example 3</title>
        <style>
            {% include "styles.css" %}
        </style>
    </head>
<body>
{% for region in report.get_data().regions %}
    <table gf-table-config="{'sheetName': '{{ region.name }}', 'freezeHeader': true}">
        <colgroup>
            <col span="5" style="width:180px;"/>
            {% for category, items in report.get_categories().items() %}
                {% for item in items %}
                    <col style="width:160px;"
                         gf-number-output-format="{'groupThousands': true, 'decimals': 2}"
                         gf-column-config="{'groups': ['items']}"/>
                {% endfor %}
                <col class="rowTotal" style="width:170px;"
                     gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
            {% endfor %}
            <col class="rowTotal" style="width:170px;" gf-column-config="{'key': 'totalSales'}"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
        </colgroup>

        <thead>
            <tr>
                <th>Region</th>
                <th>Territory</th>
                <th>Area</th>
                <th>Store</th>
                <th>Month</th>

                {% for category, items in report.get_categories().items() %}
                    {% for item in items %}
                        <th style="text-align: right"
                            gf-column-config="{'groups': '{{ category }}'}">{{ item }}</th>
                    {% endfor %}
                    <th style="text-align: right" gf-column-config="{'groups': 'categoryTotals'}">{{ category }}
                        Total
                    </th>
                {% endfor %}

                <th style="text-align: right">Total</th>
            </tr>
        </thead>

        <tbody gf-formatting-rule="[
                {'name': 'BestItemSales', 'condition': 'TOP_10_PERCENT', 'direction': 'COLUMN', 'columnGroup': 'items', 'autoGroup': false, 'cssClasses': ['bestMonth']},
                {'name': 'WorstItemSales', 'condition': 'BOTTOM_10_PERCENT', 'direction': 'COLUMN', 'columnGroup': 'items', 'autoGroup': false, 'cssClasses': ['worstMonth']}
            ]">
            {% for territory in region.territories %}
                <data-grouping
                        gf-group="{'name': '{{ report.get_safe_name(region.name, territory.name) }}'}">
                    {% for area in territory.areas %}
                        <data-grouping
                                gf-group="{'name': '{{ report.get_safe_name(region.name, territory.name, area.name) }}'}">

                            {% for store in area.stores %}
                                <data-grouping
                                        gf-group="{'name': '{{ report.get_safe_name(region.name, territory.name, area.name, store.name) }}'}">
                                    {% for month in report.get_months() %}
                                        <tr gf-named-range="{'name': '{{ report.get_safe_name(region.name, territory.name, month) }}', 'columns': 'totalSales'}">
                                            <td>{{ region.name }}</td>
                                            <td>{{ territory.name }}</td>
                                            <td>{{ area.name }}</td>
                                            <td>{{ store.name }}</td>
                                            <td>{{ month }}</td>

                                            {% for category, items in report.get_categories().items() %}
                                                {% for item in items %}
                                                    <td>{{ store.data[month][category][item] }}</td>
                                                {% endfor %}
                                                <td gf-formula="{'formula': 'SUM(@cols({{ category }}))'}">0</td>
                                            {% endfor %}
                                            <td gf-formula="{'formula': 'SUM(@cols(categoryTotals))'}">0</td>
                                        </tr>
                                    {% endfor %}
                                    {{ render_example_3_subtotals_row(region, territory, area, store, 5, report) }}
                                </data-grouping>
                            {% endfor %}
                            {{ render_example_3_subtotals_row(region, territory, area, "", 4, report) }}
                        </data-grouping>
                    {% endfor %}
                    {{ render_example_3_subtotals_row(region, territory, "", "", 3, report) }}
                </data-grouping>
            {% endfor %}
            {{ render_example_3_subtotals_row(region, "", "", "", 2, report) }}
        </tbody>
    </table>
{% endfor %}

    <!-- SUMMARY SHEET-->
    <table gf-table-config="{'sheetName': 'Summary', 'freezeHeader': true}"
           gf-formatting-rule="[
                {'name': 'BestMonthSummary', 'condition': 'MAX', 'direction': 'RANGE', 'columnGroup': 'months', 'cssClasses': ['bestMonthOverallLevel1', 'bestMonthOverallLevel2']},
                {'name': 'WorstMonthSummary', 'condition': 'MIN', 'direction': 'RANGE', 'columnGroup': 'months', 'cssClasses': ['worstMonthOverallLevel1', 'worstMonthOverallLevel2']}
            ]">
        <colgroup>
            <col span="2" style="width: 180px;"/>
            <col span="12" style="width: 160px;text-align: right;"
                 gf-column-config="{groups: 'months'}"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
            <col style="width: 160px;text-align: right;"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}" class="rowTotal"/>
        </colgroup>
        <thead>
            <tr>
                <th>Region</th>
                <th>Territory</th>
                {% for month in report.get_months() %}
                    <th gf-column-config="{'groups': 'months'}">{{ month }}</th>
                {% endfor %}
                <th>Total</th>
            </tr>
        </thead>
        {% for region in report.get_data().regions %}
            <tbody gf-group="{'name': '{{ report.get_safe_name(region.name) }}'}">
                {% for territory in region.territories %}
                    <tr>
                        <td>{{ region.name }}</td>
                        <td>{{ territory.name }}</td>
                        {% for month in report.get_months() %}
                            <td gf-formula="{'formula': 'SUM({{ report.get_safe_name(region.name, territory.name, month) }})'}">
                                0
                            </td>
                        {% endfor %}
                        <td gf-formula="{'formula': 'SUM(@cols(months))'}">0</td>
                    </tr>
                {% endfor %}
                <tr class="level2Subtotal">
                    <td>{{ region.name }}</td>
                    <td></td>
                    {% for i in range(13) %}
                        <td gf-subtotal="{}">0</td>
                    {% endfor %}
                </tr>
            </tbody>
        {% endfor %}

        <tr class="level1Subtotal">
            <td>Overall</td>
            <td></td>
            {% for i in range(13) %}
                <td gf-subtotal="{}">0</td>
            {% endfor %}
        </tr>

    </table>
</body>
</html>
