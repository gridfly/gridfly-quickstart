@using Gridfly.QuickStart
@using System.Collections.Generic
@using System.IO
@model ReportHelper
<html>
    <head>
        <title>Example 3</title>
        <style>
            @Raw(File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "Resources", "styles.css")))
        </style>
    </head>
<body>
@foreach (var region in (IEnumerable<dynamic>)((IDictionary<string, object>)Model.GetData())["regions"])
{
    <table gf-table-config="{'sheetName': '@region["name"]', 'freezeHeader': true}">
        <colgroup>
            <col span="5" style="width:180px;"/>
            @foreach (var category in Model.GetCategories())
            {
                foreach (var item in category.Value)
                {
                    <col style="width:160px;"
                         gf-number-output-format="{'groupThousands': true, 'decimals': 2}"
                         gf-column-config="{'groups': ['items']}"/>
                }
                <col class="rowTotal" style="width:170px;"
                     gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
            }
            <col class="rowTotal" style="width:170px;" gf-column-config="{'key': 'totalSales'}"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
        </colgroup>

        <thead>
            <tr>
                <th>Region</th>
                <th>Territory</th>
                <th>Area</th>
                <th>Store</th>
                <th>Month</th>

                @foreach (var category in Model.GetCategories())
                {
                    foreach (var item in category.Value)
                    {
                        <th style="text-align: right"
                            gf-column-config="{'groups': '@category.Key'}">@item</th>
                    }
                    <th style="text-align: right" gf-column-config="{'groups': 'categoryTotals'}">@category.Key Total</th>
                }

                <th style="text-align: right">Total</th>
            </tr>
        </thead>

        <tbody gf-formatting-rule="[
                {'name': 'BestItemSales', 'condition': 'TOP_10_PERCENT', 'direction': 'COLUMN', 'columnGroup': 'items', 'autoGroup': false, 'cssClasses': ['bestMonth']},
                {'name': 'WorstItemSales', 'condition': 'BOTTOM_10_PERCENT', 'direction': 'COLUMN', 'columnGroup': 'items', 'autoGroup': false, 'cssClasses': ['worstMonth']}
            ]">
            @foreach (var territory in (IEnumerable<dynamic>)region["territories"])
            {
                <data-grouping gf-group="{'name': '@Model.GetSafeName((string)region["name"], (string)territory["name"])'}">
                    @foreach (var area in (IEnumerable<dynamic>)territory["areas"])
                    {
                        <data-grouping gf-group="{'name': '@Model.GetSafeName((string)region["name"], (string)territory["name"], (string)area["name"])'}">

                            @foreach (var store in (IEnumerable<dynamic>)area["stores"])
                            {
                                <data-grouping gf-group="{'name': '@Model.GetSafeName((string)region["name"], (string)territory["name"], (string)area["name"], (string)store["name"])'}">
                                    @foreach (var month in Model.GetMonths())
                                    {
                                        <tr gf-named-range="{'name': '@Model.GetSafeName((string)region["name"], (string)territory["name"], month)', 'columns': 'totalSales'}">
                                            <td>@region["name"]</td>
                                            <td>@territory["name"]</td>
                                            <td>@area["name"]</td>
                                            <td>@store["name"]</td>
                                            <td>@month</td>

                                            @foreach (var category in Model.GetCategories())
                                            {
                                                foreach (var item in category.Value)
                                                {
                                                    <td>@store["data"][month][category.Key][item]</td>
                                                }
                                                <td gf-formula="{'formula': 'SUM(@@cols(@category.Key))'}">0</td>
                                            }
                                            <td gf-formula="{'formula': 'SUM(@@cols(categoryTotals))'}">0</td>
                                        </tr>
                                    }
                                    @{
                                        ViewBag.Region = region;
                                        ViewBag.Territory = territory;
                                        ViewBag.Area = area;
                                        ViewBag.Store = store;
                                        ViewBag.Level = 5;
                                        await IncludeAsync("_SubtotalRowEx3.cshtml", Model);
                                    }
                                </data-grouping>
                            }
                            @{
                                ViewBag.Region = region;
                                ViewBag.Territory = territory;
                                ViewBag.Area = area;
                                ViewBag.Level = 4;
                                await IncludeAsync("_SubtotalRowEx3.cshtml", Model);
                            }
                        </data-grouping>
                    }
                    @{
                        ViewBag.Region = region;
                        ViewBag.Territory = territory;
                        ViewBag.Area = null;
                        ViewBag.Level = 3;
                        await IncludeAsync("_SubtotalRowEx3.cshtml", Model);
                    }
                </data-grouping>
            }
            @{
                ViewBag.Region = region;
                ViewBag.Territory = null;
                ViewBag.Level = 2;
                await IncludeAsync("_SubtotalRowEx3.cshtml", Model);
            }
        </tbody>
    </table>
}

    <!-- SUMMARY SHEET-->
    <table gf-table-config="{'sheetName': 'Summary', 'freezeHeader': true}"
           gf-formatting-rule="[
                {'name': 'BestMonthSummary', 'condition': 'MAX', 'direction': 'RANGE', 'columnGroup': 'months', 'cssClasses': ['bestMonthOverallLevel1', 'bestMonthOverallLevel2']},
                {'name': 'WorstMonthSummary', 'condition': 'MIN', 'direction': 'RANGE', 'columnGroup': 'months', 'cssClasses': ['worstMonthOverallLevel1', 'worstMonthOverallLevel2']}
            ]">
        <colgroup>
            <col span="2" style="width: 180px;"/>
            <col span="12" style="width: 160px;text-align: right;"
                 gf-column-config="{groups: 'months'}"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}"/>
            <col style="width: 160px;text-align: right;"
                 gf-number-output-format="{'groupThousands': true, 'decimals': 2}" class="rowTotal"/>
        </colgroup>
        <thead>
            <tr>
                <th>Region</th>
                <th>Territory</th>
                @foreach (var month in Model.GetMonths())
                {
                    <th gf-column-config="{'groups': 'months'}">@month</th>
                }
                <th>Total</th>
            </tr>
        </thead>
        @foreach (var region in (IEnumerable<dynamic>)((IDictionary<string, object>)Model.GetData())["regions"])
        {
            <tbody gf-group="{'name': '@Model.GetSafeName((string)region["name"])'}">
                @foreach (var territory in (IEnumerable<dynamic>)region["territories"])
                {
                    <tr>
                        <td>@region["name"]</td>
                        <td>@territory["name"]</td>
                        @foreach (var month in Model.GetMonths())
                        {
                            <td gf-formula="{'formula': 'SUM(@Model.GetSafeName((string)region["name"], (string)territory["name"], month))'}">
                                0
                            </td>
                        }
                        <td gf-formula="{'formula': 'SUM(@@cols(months))'}">0</td>
                    </tr>
                }
                <tr class="level2Subtotal">
                    <td>@region["name"]</td>
                    <td></td>
                    @for (int i = 0; i < 13; i++)
                    {
                        <td gf-subtotal="{}">0</td>
                    }
                </tr>
            </tbody>
        }

        <tr class="level1Subtotal">
            <td>Overall</td>
            <td></td>
            @for (int i = 0; i < 13; i++)
            {
                <td gf-subtotal="{}">0</td>
            }
        </tr>

    </table>
</body>
</html>
